rules_version = '2';
// 휠체어럭비 퀴즈 공유 랭킹 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 파일 내용을 그대로 붙여넣고 '게시'.
// - 누구나 순위를 읽을 수 있음
// - 쓰기는 익명 로그인한 본인 문서만, 정해진 칸과 숫자 범위만
// - 명예의 전당은 처음 한 번만 쓸 수 있고 고치거나 지울 수 없음
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn(uid) { return request.auth != null && request.auth.uid == uid; }
    function okNick(n) { return n is string && n.size() > 0 && n.size() <= 14; }
    function okGrade(g) { return g is int && g >= 0 && g <= 6; }
    function okLang(l) { return l == 'ko' || l == 'en'; }

    match /players/{uid} {
      allow read: if true;
      allow create, update: if signedIn(uid)
        && request.resource.data.keys().hasOnly(['nick', 'total', 'grade', 'en', 'at'])
        && okNick(request.resource.data.nick)
        && request.resource.data.total is int
        && request.resource.data.total >= 0 && request.resource.data.total <= 200000
        && okGrade(request.resource.data.grade)
        && request.resource.data.en is bool
        && request.resource.data.at == request.time;
    }

    match /weeks/{wk}/players/{uid} {
      allow read: if true;
      allow create, update: if signedIn(uid)
        && wk.matches('^[0-9]{4}-W[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['nick', 'xp', 'grade', 'en', 'at'])
        && okNick(request.resource.data.nick)
        && request.resource.data.xp is int
        && request.resource.data.xp >= 0 && request.resource.data.xp <= 30000
        && okGrade(request.resource.data.grade)
        && request.resource.data.en is bool
        && request.resource.data.at == request.time;
    }

    match /hall/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && okLang(request.resource.data.lang)
        && id == request.auth.uid + '_' + request.resource.data.lang
        && request.resource.data.keys().hasOnly(['nick', 'lang', 'at'])
        && okNick(request.resource.data.nick)
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
  }
}
